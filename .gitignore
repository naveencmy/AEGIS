*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environments
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/

# Testing & Coverage
.pytest_cache/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.log
.mypy_cache/
.ruff_cache/

# Node & Frontend Build
node_modules/
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/.cache/
*.local
.npm/
.eslintcache

# Environment Variables & Secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem
*.key
*.cert

# Local Vector Store & Heavy Cache DBs (Keep .gitkeep)
data/chroma/*
!data/chroma/.gitkeep
backend/data/chroma/*
!backend/data/chroma/.gitkeep
backend/checkpoints/*
!backend/checkpoints/.gitkeep
data/raw/kev/*
!data/raw/kev/.gitkeep
data/raw/mitre/*
!data/raw/mitre/.gitkeep
data/raw/nvd/*
!data/raw/nvd/.gitkeep
data/raw/sigma/*
!data/raw/sigma/.gitkeep
data/sigma_repo/

# SQLite & Persistent Databases
*.sqlite
*.sqlite3
*.db

# Operating System & IDEs
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Nn]otebooks/.ipynb_checkpoints
.idea/
.vscode/
*.swp
*.swo

# Temporary Files & Test Captures
scratch/
temp/
*.tmp
frontend/test-screenshots/
*.png
