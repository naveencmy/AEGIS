# ==============================================================================
# AEGIS Cyber Sentinel - Production Environment Configuration
# ==============================================================================

# Application Metadata
APP_NAME="AEGIS - Sovereign Cybersecurity Co-Pilot"
APP_VERSION="0.1.0"
DEBUG=false
ENVIRONMENT=production

# Server Binding
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=["http://localhost:5173", "http://localhost:80", "http://localhost"]

# Vector Database (ChromaDB)
CHROMA_PERSIST_DIR="data/chroma"
COLLECTION_UNIFIED="aegis_intel_unified"
COLLECTION_NVD="aegis_intel_nvd"
COLLECTION_MITRE="aegis_intel_mitre"
COLLECTION_KEV="aegis_intel_cisa_kev"
COLLECTION_SIGMA="aegis_intel_sigma"

# Dense Embeddings & Cross-Encoder Reranker
EMBEDDING_MODEL="BAAI/bge-m3"
RERANKER_MODEL="BAAI/bge-reranker-v2-m3"
RETRIEVAL_TOP_K=15
RERANK_TOP_N=5
RERANK_SCORE_THRESHOLD=0.35

# Sovereign LLM Inference (Mistral 7B via Ollama or llama-cpp-python)
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="mistral:7b-instruct-q4_K_M"
TEMPERATURE=0.1
TOP_P=0.9
FIXED_SEED=42

# Live Ingestion Upstream Endpoints
NVD_API_URL="https://services.nvd.nist.gov/rest/json/cves/2.0"
CISA_KEV_URL="https://www.cisa.gov/sites/default/files/feeds/known_exploited_vulnerabilities.json"
MITRE_ATTACK_URL="https://raw.githubusercontent.com/mitre/cti/master/enterprise-attack/enterprise-attack.json"
SIGMA_REPO_URL="https://github.com/SigmaHQ/sigma.git"
SIGMA_RULES_ZIP="https://github.com/SigmaHQ/sigma/archive/refs/heads/master.zip"

# Ingestion Policies & Rate Limiting
NVD_RATE_LIMIT_DELAY=6.0
MAX_INGESTION_RETRIES=3
RETRY_BACKOFF_FACTOR=2.0
NVD_API_KEY="" # Optional: NIST NVD API key (increases rate limit from 5 req/30s to 50 req/30s)
